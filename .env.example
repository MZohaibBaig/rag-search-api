# Database
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/rag_search_db

# Postgres container password. docker-compose.yml uses this for BOTH the db
# service and the app service's DATABASE_URL, so those two stay in sync with
# each other. It does NOT keep the DATABASE_URL line above in sync — that one
# has its own embedded password, read directly by `uvicorn app.main:app`
# when you run the API locally against the containerised Postgres. If you
# change POSTGRES_PASSWORD, update the DATABASE_URL line above to match.
POSTGRES_PASSWORD=change-me

# JWT
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq API
GROQ_API_KEY=your-groq-api-key

# Embeddings Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Server
DEBUG=False

# CORS (comma-separated origins allowed to call this API)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173