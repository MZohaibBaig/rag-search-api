# Used when you run `uvicorn` directly (not via docker-compose), e.g.
# against a locally installed Postgres. Independent of POSTGRES_PASSWORD
# below — these can point at different servers with different passwords,
# and commonly do (a native local Postgres vs. the Docker one).
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/rag_search_db

# Postgres container password. docker-compose.yml uses this for BOTH the db
# service and the app service's DATABASE_URL, so those two stay in sync with
# each other — but only within docker-compose. It has no relationship to the
# DATABASE_URL line above.
POSTGRES_PASSWORD=change-me

# JWT
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq API
GROQ_API_KEY=your-groq-api-key

# Embeddings Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Server
DEBUG=False

# CORS (comma-separated origins allowed to call this API)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173