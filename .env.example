# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/rag_search_db

# Postgres container password (used by docker-compose for both the db
# service and the app's DATABASE_URL — single source, they can't drift)
POSTGRES_PASSWORD=change-me

# JWT
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Groq API
GROQ_API_KEY=your-groq-api-key

# Embeddings Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Server
DEBUG=False

# CORS (comma-separated origins allowed to call this API)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173